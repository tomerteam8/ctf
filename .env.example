# LLM Provider: "openai" | "anthropic" | "local"
# Use "local" only for development with the Claude CLI installed.
VITE_LLM_PROVIDER=anthropic

# Optional: bake an API key into the build (set via CI secret, not locally).
# When set, users don't need to enter a key in the UI.
# VITE_ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model for the chosen provider:
# VITE_LLM_MODEL=gpt-4o-mini           # openai default
# VITE_LLM_MODEL=claude-sonnet-4-20250514  # anthropic default
